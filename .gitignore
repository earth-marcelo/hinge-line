# dados (mantenha dados grandes/brutos fora do git)
data/*
!data/.gitkeep
!data/raw
data/raw/*
!data/raw/.gitkeep
!data/raw/sandwell
data/raw/sandwell/*
!data/raw/sandwell/.gitkeep
!data/raw/gebco
data/raw/gebco/*
!data/raw/gebco/.gitkeep
!data/raw/emag2
data/raw/emag2/*
!data/raw/emag2/.gitkeep
!data/raw/marine
data/raw/marine/*
!data/raw/marine/.gitkeep
# terrestrial_cprm é exceção: o shapefile fonte é pequeno (~4MB) e não dá
# para "rebaixar" com um script (foi um achado manual, sem API) — vale a
# pena versionar o arquivo original. Só o CSV recortado por AOI (derivado,
# reproduzível a partir do shapefile) fica de fora.
!data/raw/terrestrial_cprm
data/raw/terrestrial_cprm/*
!data/raw/terrestrial_cprm/Gravimetria_CPRM_2022_vr1.*
!data/processed
data/processed/*
!data/processed/.gitkeep

# arquivos salvos pelo app do Claude (entregas de chat, não são do projeto)
Claude outputs/

# python
__pycache__/
*.pyc
.ipynb_checkpoints/
venv/
.venv/
*.egg-info/

# ambiente
.env

# sistema
.DS_Store
